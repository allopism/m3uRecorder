# Copia este archivo como .env y rellena tus valores.

# ── Web ──────────────────────────────────────
# Puerto del host donde se publica la interfaz
WEB_PORT=9984
TZ=Europe/Madrid
# Token de acceso a la web y a la API (genera uno con: openssl rand -hex 24).
# Si lo dejas vacío no se pide autenticación: úsalo así solo en una red de confianza.
APP_TOKEN=

# ── Rutas en el host ─────────────────────────
# Carpeta donde se guardan las grabaciones
RECORDINGS_DIR=./output
# Lista de canales (por ejemplo, una de https://github.com/iptv-org/iptv)
M3U_LIST_PATH=./lista.m3u
# Usuario y grupo dueños de RECORDINGS_DIR (en Linux: id -u / id -g)
PUID=1000
PGID=1000

# ── VPN (Gluetun) ────────────────────────────
# false = usar la app sin VPN (oculta los controles). Si lo pones a false,
# quita también el servicio gluetun y el network_mode del docker-compose.
VPN_ENABLED=true
# Proveedores compatibles: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
# País por defecto al arrancar
SERVER_COUNTRIES=Spain
# Clave de la API de control de Gluetun (genera una con: openssl rand -hex 24)
GLUETUN_API_KEY=

# ── Notificaciones de Telegram (opcional) ────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
